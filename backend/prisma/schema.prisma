
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ACCOUNT_HOLDER
  AUDITOR

  // Retained temporarily for migration compatibility.
  // Existing CUSTOMER users will be migrated to ACCOUNT_HOLDER.
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum AccountType {
  CUSTOMER
  SYSTEM
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum TransactionStatus {
  COMPLETED
  FAILED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(ACCOUNT_HOLDER)
  status       UserStatus @default(ACTIVE)

  onboardingRequest OnboardingRequest?
  reviewedRequests  OnboardingRequest[] @relation("OnboardingReviewer")
  accounts          Account[]
  transactions      Transaction[]       @relation("InitiatedTransactions")
  auditLogs         AuditLog[]           @relation("AuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, status])
}

model OnboardingRequest {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @unique @db.Uuid
  status       OnboardingStatus @default(PENDING)
  reviewedById String?          @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?

  user       User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("OnboardingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([reviewedById])
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  accountNumber String        @unique
  userId        String?       @db.Uuid
  type          AccountType   @default(CUSTOMER)
  balancePaise  BigInt        @default(0)
  status        AccountStatus @default(ACTIVE)
  currency      String        @default("INR")

  user                 User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  outgoingTransactions Transaction[] @relation("SourceAccount")
  incomingTransactions Transaction[] @relation("DestinationAccount")
  ledgerEntries        LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([type, status])
}

model Transaction {
  id          String            @id @default(uuid()) @db.Uuid
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  amountPaise BigInt
  description String?

  fromAccountId String? @db.Uuid
  toAccountId   String? @db.Uuid
  initiatedById String  @db.Uuid

  fromAccount Account? @relation("SourceAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account? @relation("DestinationAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  initiatedBy User     @relation("InitiatedTransactions", fields: [initiatedById], references: [id], onDelete: Restrict)

  ledgerEntries  LedgerEntry[]
  idempotencyKey IdempotencyKey?

  createdAt DateTime @default(now())

  @@index([initiatedById, createdAt])
  @@index([fromAccountId, createdAt])
  @@index([toAccountId, createdAt])
}

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  transactionId String          @db.Uuid
  accountId     String          @db.Uuid
  direction     LedgerDirection
  amountPaise   BigInt

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([accountId, createdAt])
}

model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  actorId    String? @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model IdempotencyKey {
  id            String  @id @default(uuid()) @db.Uuid
  key           String  @unique
  requestHash   String
  transactionId String? @unique @db.Uuid

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([expiresAt])
}
